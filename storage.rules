rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return signedIn()
          ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
          : null;
    }

    function isAdmin() {
      return currentRole() == 'ADMIN';
    }

    function isManager() {
      return currentRole() == 'MANAGER';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function canReadRetainedChatAttachment(sessionId) {
      return signedIn()
          && (
            isAdmin()
            || (
              firestore.exists(
                /databases/(default)/documents/companionSessions/$(sessionId)
              )
              && firestore.get(
                /databases/(default)/documents/companionSessions/$(sessionId)
              ).data.patientUserId == request.auth.uid
            )
          );
    }

    function isAllowedDocumentKey(documentKey) {
      return documentKey == 'idCard'
          || documentKey == 'license'
          || documentKey == 'healthCertificate'
          || documentKey == 'criminalRecord';
    }

    function isAllowedDocumentContentType() {
      return request.resource != null
          && request.resource.contentType is string
          && (
            request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*')
          );
    }

    function isAllowedDocumentSize() {
      return request.resource != null
          && request.resource.size is int
          && request.resource.size <= 10485760;
    }

    match /manager-documents/{managerUserId}/{documentKey}/{fileName} {
      allow read: if isAdmin() || (isManager() && isSelf(managerUserId));
      allow write: if isManager()
          && isSelf(managerUserId)
          && isAllowedDocumentKey(documentKey)
          && isAllowedDocumentContentType()
          && isAllowedDocumentSize();
    }

    match /companion-chat-attachments/{sessionId}/{fileName} {
      // 매니저·보호자 조회와 모든 쓰기는 Core API를 거쳐야 한다. 서버 SDK는 Rules를 우회한다.
      allow read: if canReadRetainedChatAttachment(sessionId);
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
