<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_manager_qualification_complete_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_manager_qualification_complete_icon">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_figma_manager_qualification_complete" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="@string/figma_manager_qualification_complete_title"
            android:textColor="@color/figma_mvp_text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="@string/figma_manager_qualification_complete_body"
            android:textColor="@color/figma_mvp_text_tertiary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonManagerQualificationCompleteConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_figma_primary_button"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="@string/figma_manager_qualification_complete_confirm"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
