<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/figma_mvp_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/figma_manager_qualification_upload_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_manager_qualification_icon_upload">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_figma_manager_qualification_upload" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textManagerDocumentRegistrationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textManagerDocumentRegistrationHelper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/figma_mvp_text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textManagerDocumentRegistrationFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textManagerDocumentRegistrationFileMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/figma_mvp_primary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/textManagerDocumentRegistrationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_surface_pill"
            android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
            android:fontFamily="@font/pretendard_bold"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonManagerDocumentRegistrationPreview"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/manager_document_preview_button"
                android:textAllCaps="false"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="11sp"
                android:visibility="gone"
                app:backgroundTint="@color/figma_manager_qualification_privacy_icon"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonManagerDocumentRegistrationUpload"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/manager_document_registration_upload_button"
                android:textAllCaps="false"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/figma_mvp_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="18dp"
                app:strokeColor="@color/figma_manager_qualification_upload_outline"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
