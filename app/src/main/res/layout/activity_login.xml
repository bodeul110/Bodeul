<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_mvp_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minHeight="884dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="64dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/buttonLoginBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/figma_login_back_content_description"
            android:padding="16dp"
            app:srcCompat="@drawable/figma_login_back" />

        <ImageView
            android:layout_width="210dp"
            android:layout_height="149dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/bodeul_logo_figma" />

        <TextView
            android:id="@+id/textLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/pretendard_bold"
            android:includeFontPadding="false"
            android:textColor="@color/figma_mvp_text_primary"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textLoginSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/pretendard_semibold"
            android:includeFontPadding="false"
            android:textColor="@color/figma_mvp_text_secondary"
            android:textSize="18sp" />

        <include
            android:id="@+id/layoutLoginSummaryCard"
            layout="@layout/view_auth_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/textDemoBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_surface_pill"
            android:fontFamily="@font/pretendard_medium"
            android:lineSpacingExtra="3dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="@color/figma_mvp_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/roleChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleManager"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:text="@string/login_role_manager"
                android:textColor="@color/figma_mvp_text_primary"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/figma_mvp_input"
                app:chipCornerRadius="22dp"
                app:chipStrokeColor="@color/figma_mvp_divider"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRolePatient"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:text="@string/login_role_patient"
                android:textColor="@color/figma_mvp_text_primary"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/figma_mvp_input"
                app:chipCornerRadius="22dp"
                app:chipStrokeColor="@color/figma_mvp_divider"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoleGuardian"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:text="@string/login_role_guardian"
                android:textColor="@color/figma_mvp_text_primary"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/figma_mvp_input"
                app:chipCornerRadius="22dp"
                app:chipStrokeColor="@color/figma_mvp_divider"
                app:chipStrokeWidth="1dp" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutName"
            style="@style/BodeulFigmaFilledInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/login_name_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:inputType="textPersonName"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPhone"
            style="@style/BodeulFigmaFilledInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/login_phone_hint"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:inputType="phone"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmail"
            style="@style/BodeulFigmaFilledInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="@string/login_email_or_id_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:hint="@string/figma_login_email_placeholder"
                android:inputType="textEmailAddress"
                android:textColor="@color/figma_mvp_text_primary"
                android:textColorHint="@color/figma_mvp_text_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPassword"
            style="@style/BodeulFigmaFilledInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/login_password_hint"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:hint="@string/figma_login_password_placeholder"
                android:inputType="textPassword"
                android:textColor="@color/figma_mvp_text_primary"
                android:textColorHint="@color/figma_mvp_text_hint"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonSubmitAuth"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_figma_primary_button"
            android:elevation="4dp"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/progressAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:indicatorColor="@color/figma_mvp_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/textForgotPassword"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center_vertical|start"
                android:text="@string/forgot_password"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textSwitchMode"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center_vertical|end"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textResendVerification"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/resend_verification_email"
            android:textColor="@color/figma_mvp_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutSocialDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/figma_mvp_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/figma_login_social_divider"
                android:textColor="@color/figma_mvp_text_hint"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/figma_mvp_divider" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSocialButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/buttonSocialKakao"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_figma_social_kakao"
                android:contentDescription="@string/social_login_kakao_content_description"
                android:elevation="2dp"
                android:padding="18dp"
                app:srcCompat="@drawable/figma_kakao_mark" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/buttonSocialGoogle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_figma_social_google"
                android:contentDescription="@string/social_login_google_content_description"
                android:elevation="2dp"
                android:padding="16dp"
                app:srcCompat="@drawable/figma_google_mark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSocialNaver"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:fontFamily="@font/pretendard_bold"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="@string/social_login_naver_short"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:visibility="gone"
                app:backgroundTint="@color/figma_mvp_naver"
                app:cornerRadius="28dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSocialHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/social_login_helper"
            android:textColor="@color/figma_mvp_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:text="@string/figma_login_copyright"
            android:textColor="@color/figma_mvp_text_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
