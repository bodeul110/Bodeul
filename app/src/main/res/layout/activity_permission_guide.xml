<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_mvp_background">

    <ScrollView
        android:id="@+id/scrollPermissionGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="116dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="148dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="104dp">

                <ImageView
                    android:layout_width="171dp"
                    android:layout_height="121dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="-28dp"
                    android:layout_marginTop="-8dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bodeul_logo_figma" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/buttonPermissionClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center_vertical|end"
                    android:background="@drawable/bg_figma_neutral_circle"
                    android:contentDescription="@string/common_close"
                    android:padding="17dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/figma_mvp_text_tertiary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/pretendard_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.025"
                android:text="@string/figma_permission_title"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="30sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="9dp"
                android:text="@string/figma_permission_description"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/layoutPermissionItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_figma_permission_description"
                android:fontFamily="@font/pretendard_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:text="@string/permission_guide_footer"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonPermissionOpenNotificationSettings"
                style="@style/BodeulOutlinedButton"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/pretendard_semibold"
                android:text="@string/permission_notification_settings"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutPermissionBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/figma_mvp_surface"
        android:gravity="top"
        android:minHeight="116dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonPermissionConfirm"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_figma_primary_button"
            android:elevation="4dp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="@string/figma_permission_confirm"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
