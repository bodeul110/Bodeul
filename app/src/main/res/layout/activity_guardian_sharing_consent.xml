<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glow"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="94dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/bodeul_logo_full" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/buttonBackGuardianSharingConsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_pill"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="@string/guide_back"
                android:textColor="@color/bodeul_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/guardian_sharing_consent_title"
            android:textColor="@color/bodeul_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/guardian_sharing_consent_subtitle"
            android:textColor="@color/bodeul_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/bodeul_surface"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/bodeul_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textGuardianSharingConsentStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardian_sharing_consent_status_loading"
                    android:textColor="@color/bodeul_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textGuardianSharingConsentExpiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/guardian_sharing_consent_expiry_rule"
                    android:textColor="@color/bodeul_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/guardian_sharing_consent_scope_title"
            android:textColor="@color/bodeul_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkGuardianSharingAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="@string/guardian_sharing_scope_appointment" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkGuardianSharingChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardian_sharing_scope_chat" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkGuardianSharingAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardian_sharing_scope_attachment" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkGuardianSharingReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/guardian_sharing_scope_report" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkGuardianSharingLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/guardian_sharing_scope_location_unavailable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/guardian_sharing_consent_notice"
            android:textColor="@color/bodeul_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkGuardianSharingAdultPatient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/guardian_sharing_consent_adult_confirmation" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSaveGuardianSharingConsent"
            style="@style/BodeulHomeButton"
            android:layout_marginTop="22dp"
            android:text="@string/guardian_sharing_consent_save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRevokeGuardianSharingConsent"
            style="@style/BodeulOutlinedButton"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/guardian_sharing_consent_revoke" />

        <ProgressBar
            android:id="@+id/progressGuardianSharingConsent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:indicatorColor="@color/bodeul_primary" />
    </LinearLayout>
</ScrollView>
