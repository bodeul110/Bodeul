<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bookingAppointmentSelectorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_mvp_background">

    <ScrollView
        android:id="@+id/scrollBookingAppointmentSelector"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="72dp"
        android:paddingBottom="132dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:text="@string/booking_appointment_schedule_heading"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:text="@string/booking_appointment_schedule_helper"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/booking_appointment_schedule_date_title"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/buttonBookingAppointmentPreviousMonth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/booking_appointment_schedule_previous_month"
                    android:padding="16dp"
                    android:src="@drawable/ic_figma_booking_schedule_previous" />

                <TextView
                    android:id="@+id/textBookingAppointmentDisplayedMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="92dp"
                    android:textColor="@color/figma_mvp_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/buttonBookingAppointmentNextMonth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/booking_appointment_schedule_next_month"
                    android:padding="16dp"
                    android:src="@drawable/ic_figma_booking_schedule_next" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/figma_mvp_surface"
                app:cardCornerRadius="32dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/figma_booking_schedule_calendar_outline"
                app:strokeWidth="1dp">

                <GridLayout
                    android:id="@+id/gridBookingAppointmentCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="7"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="22dp"
                    android:useDefaultMargins="false" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/booking_appointment_schedule_time_title"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_figma_booking_schedule_time_badge"
                    android:fontFamily="@font/pretendard_bold"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="@string/booking_appointment_schedule_time_badge"
                    android:textColor="@color/figma_mvp_patient_icon_background"
                    android:textSize="11sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/gridBookingAppointmentTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-6dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="-6dp"
                android:alignmentMode="alignMargins"
                android:columnCount="3"
                android:useDefaultMargins="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textBookingAppointmentSelectedTime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/pretendard_medium"
                    android:gravity="center_vertical"
                    android:textColor="@color/figma_mvp_text_tertiary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonBookingAppointmentCustomTime"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="@font/pretendard_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/booking_appointment_schedule_custom_time"
                    android:textAllCaps="false"
                    android:textColor="@color/figma_mvp_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/figma_booking_schedule_slot_outline"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_figma_booking_schedule_info_box"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <FrameLayout
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:background="@drawable/bg_figma_booking_schedule_info_icon">

                    <ImageView
                        android:layout_width="33dp"
                        android:layout_height="33dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_figma_booking_schedule_info" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/booking_appointment_schedule_info_title"
                        android:textColor="@color/figma_mvp_gold_text"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/pretendard_medium"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/booking_appointment_schedule_info_body"
                        android:textColor="@color/figma_booking_schedule_info_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="144dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/figma_mvp_input"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/booking_appointment_schedule_image_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/figma_booking_hospital_atmosphere" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_figma_booking_schedule_image_overlay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="24dp"
                    android:fontFamily="@font/pretendard_bold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/booking_appointment_schedule_image_text"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBookingAppointmentTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/figma_booking_schedule_top_bar"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/buttonBookingAppointmentBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/booking_appointment_schedule_back"
            android:padding="16dp"
            android:src="@drawable/ic_figma_booking_schedule_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:includeFontPadding="false"
            android:text="@string/booking_appointment_schedule_app_bar_title"
            android:textColor="@color/figma_mvp_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBookingAppointmentBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/figma_booking_schedule_footer"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingAppointmentComplete"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:fontFamily="@font/pretendard_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/booking_appointment_schedule_complete"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@color/figma_mvp_primary"
            app:cornerRadius="16dp" />
    </LinearLayout>
</FrameLayout>
