<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:letterSpacing="0.1"
        android:text="@string/guide_vitals_step"
        android:textColor="@color/figma_mvp_primary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/pretendard_bold"
        android:includeFontPadding="false"
        android:text="@string/guide_vitals_title"
        android:textColor="@color/figma_mvp_text_primary"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_figma_vitals_progress_track"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:background="@drawable/bg_figma_vitals_progress_fill" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/textGuideVitalsHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/pretendard_medium"
        android:lineSpacingExtra="2dp"
        android:text="@string/guide_vitals_helper_unknown"
        android:textColor="@color/figma_mvp_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/guide_vitals_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_figma_vitals_blood_icon"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_figma_vitals_blood" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/guide_vitals_blood_pressure"
                        android:textColor="@color/figma_mvp_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="@string/guide_vitals_blood_pressure_caption"
                        android:textColor="@color/figma_mvp_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/guide_vitals_systolic"
                        android:textColor="@color/figma_mvp_text_secondary"
                        android:textSize="11sp" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputGuideVitalsSystolic"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_figma_vitals_input"
                        android:fontFamily="@font/pretendard_medium"
                        android:gravity="center_vertical"
                        android:hint="@string/guide_vitals_systolic_hint"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/figma_mvp_text_primary"
                        android:textColorHint="@color/guide_vitals_input_hint"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/guide_vitals_diastolic"
                        android:textColor="@color/figma_mvp_text_secondary"
                        android:textSize="11sp" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputGuideVitalsDiastolic"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_figma_vitals_input"
                        android:fontFamily="@font/pretendard_medium"
                        android:gravity="center_vertical"
                        android:hint="@string/guide_vitals_diastolic_hint"
                        android:inputType="number"
                        android:maxLength="3"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="@color/figma_mvp_text_primary"
                        android:textColorHint="@color/guide_vitals_input_hint"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/guide_vitals_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_figma_vitals_heart_icon"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_figma_vitals_heart_rate" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/guide_vitals_heart_rate"
                        android:textColor="@color/figma_mvp_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="@string/guide_vitals_heart_rate_caption"
                        android:textColor="@color/figma_mvp_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputGuideVitalsHeartRate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_figma_vitals_input"
                    android:fontFamily="@font/pretendard_medium"
                    android:gravity="center_vertical"
                    android:hint="@string/guide_vitals_heart_rate_hint"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingStart="16dp"
                    android:paddingEnd="58dp"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textColorHint="@color/guide_vitals_input_hint"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:fontFamily="@font/pretendard_semibold"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="16dp"
                    android:text="@string/guide_vitals_heart_rate_unit"
                    android:textColor="@color/figma_mvp_text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="22dp"
        app:cardBackgroundColor="@color/figma_mvp_surface"
        app:cardCornerRadius="48dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/guide_vitals_card_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_figma_vitals_weight_icon"
                    android:contentDescription="@null"
                    android:padding="11dp"
                    android:src="@drawable/ic_figma_vitals_weight" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="@string/guide_vitals_weight"
                        android:textColor="@color/figma_mvp_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_semibold"
                        android:text="@string/guide_vitals_weight_caption"
                        android:textColor="@color/figma_mvp_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputGuideVitalsWeight"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_figma_vitals_input"
                    android:digits="0123456789."
                    android:fontFamily="@font/pretendard_medium"
                    android:gravity="center_vertical"
                    android:hint="@string/guide_vitals_weight_hint"
                    android:inputType="numberDecimal"
                    android:maxLength="5"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="@color/figma_mvp_text_primary"
                    android:textColorHint="@color/guide_vitals_input_hint"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:fontFamily="@font/pretendard_semibold"
                    android:gravity="center"
                    android:paddingStart="0dp"
                    android:paddingEnd="16dp"
                    android:text="@string/guide_vitals_weight_unit"
                    android:textColor="@color/figma_mvp_text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
