<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/figma_mvp_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="144dp">

            <ImageView
                android:id="@+id/imageRoleLogo"
                android:layout_width="171dp"
                android:layout_height="121dp"
                android:layout_marginStart="-24dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/bodeul_logo_figma" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/pretendard_bold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.025"
                android:text="@string/role_select_title"
                android:textColor="@color/figma_mvp_text_primary"
                android:textSize="36sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_semibold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="9dp"
                android:text="@string/figma_role_select_subtitle"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="18sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardManagerType"
                android:layout_width="match_parent"
                android:layout_height="306dp"
                android:layout_marginTop="48dp"
                android:clipToOutline="true"
                app:cardBackgroundColor="@color/figma_mvp_surface"
                app:cardCornerRadius="48dp"
                app:cardElevation="4dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="@color/figma_mvp_primary"
                app:strokeWidth="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-32dp"
                        android:layout_marginEnd="-32dp"
                        android:background="@drawable/bg_figma_manager_corner" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="34dp">

                        <ImageView
                            android:layout_width="62dp"
                            android:layout_height="59dp"
                            android:contentDescription="@string/role_manager_title"
                            android:src="@drawable/figma_role_manager" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:fontFamily="@font/pretendard_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/role_manager_title"
                            android:textColor="@color/figma_mvp_text_primary"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_semibold"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="6dp"
                            android:text="@string/figma_role_manager_description"
                            android:textColor="@color/figma_mvp_text_secondary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textManagerAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/figma_role_manager_action"
                                android:textColor="@color/figma_mvp_primary"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/figma_role_arrow" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/textManagerCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="32dp"
                        android:background="@drawable/bg_figma_primary_circle">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/role_selected_mark"
                            android:src="@drawable/figma_role_check" />
                    </FrameLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPatientType"
                android:layout_width="match_parent"
                android:layout_height="306dp"
                android:layout_marginTop="24dp"
                android:clipToOutline="true"
                app:cardBackgroundColor="@color/figma_mvp_surface"
                app:cardCornerRadius="48dp"
                app:cardElevation="4dp"
                app:cardPreventCornerOverlap="false"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <View
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-32dp"
                        android:layout_marginEnd="-32dp"
                        android:background="@drawable/bg_figma_patient_corner" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="34dp">

                        <ImageView
                            android:layout_width="63dp"
                            android:layout_height="62dp"
                            android:contentDescription="@string/role_patient_guardian_title"
                            android:src="@drawable/figma_role_patient" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="29dp"
                            android:fontFamily="@font/pretendard_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/role_patient_guardian_title"
                            android:textColor="@color/figma_mvp_text_primary"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_semibold"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="6dp"
                            android:text="@string/figma_role_patient_description"
                            android:textColor="@color/figma_mvp_text_secondary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textPatientAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/figma_role_patient_action"
                                android:textColor="@color/figma_mvp_primary"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/figma_role_arrow" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/textPatientCheck"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="32dp"
                        android:background="@drawable/bg_figma_primary_circle"
                        android:visibility="invisible">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/role_selected_mark"
                            android:src="@drawable/figma_role_check" />
                    </FrameLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_figma_bottom_fade"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonContinueRole"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_figma_primary_button"
            android:elevation="4dp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="@string/next_step"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
