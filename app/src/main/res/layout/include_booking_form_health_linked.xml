<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/booking_health_section"
        android:textColor="@color/bodeul_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/booking_health_helper"
        android:textColor="@color/bodeul_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/figma_mvp_background"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/figma_mvp_divider"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textBookingHealthProfileSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:text="@string/booking_health_profile_main_summary_empty"
                android:textColor="@color/figma_mvp_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textBookingHealthProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pretendard_medium"
                android:includeFontPadding="false"
                android:text="@string/booking_health_profile_main_error"
                android:textColor="@color/bodeul_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBookingHealthProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/pretendard_semibold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/booking_health_profile_main_action"
                android:textAllCaps="false"
                android:textColor="@color/figma_mvp_primary"
                android:textSize="14sp"
                app:backgroundTint="@color/figma_mvp_surface"
                app:cornerRadius="24dp"
                app:strokeColor="@color/figma_mvp_divider"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingHealthSummary"
        style="@style/BodeulFilledInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/booking_health_summary_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputBookingHealthSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingMedicationSummary"
        style="@style/BodeulFilledInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/booking_medication_summary_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputBookingMedicationSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/booking_mobility_section"
        android:textColor="@color/bodeul_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingMobilityIndependent"
            style="@style/BodeulOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/booking_mobility_independent"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingMobilityWalkingAid"
            style="@style/BodeulOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/booking_mobility_walking_aid"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonBookingMobilityWheelchair"
            style="@style/BodeulOutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:text="@string/booking_mobility_wheelchair"
            android:textSize="13sp" />
    </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/textBookingLinkedSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/booking_linked_section_default"
        android:textColor="@color/bodeul_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textBookingLinkedHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/booking_linked_helper_default"
        android:textColor="@color/bodeul_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingLinkedName"
        style="@style/BodeulFilledInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/booking_linked_name_hint_default">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputBookingLinkedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingLinkedPhone"
        style="@style/BodeulFilledInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/booking_linked_phone_hint_default">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputBookingLinkedPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutBookingLinkedEmail"
        style="@style/BodeulFilledInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/booking_linked_email_hint_default">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputBookingLinkedEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>
</merge>
