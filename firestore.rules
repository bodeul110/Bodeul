rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentUserExists()
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : null;
    }

    function isAdmin() {
      // 관리자 업무는 PostgreSQL 세부 역할을 확인하는 Next.js 서버 route만 수행한다.
      // Firestore Rules는 PostgreSQL을 조회할 수 없으므로 ADMIN 브라우저 권한을 fail-closed로 둔다.
      return false;
    }

    function isManager() {
      return currentRole() == 'MANAGER';
    }

    function isPatient() {
      return currentRole() == 'PATIENT';
    }

    function isGuardian() {
      return currentRole() == 'GUARDIAN';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isClientCreatableRole(role) {
      return role == 'PATIENT'
          || role == 'GUARDIAN'
          || role == 'MANAGER';
    }

    function appointmentExists(appointmentRequestId) {
      return exists(
          /databases/$(database)/documents/appointmentRequests/$(appointmentRequestId)
      );
    }

    function appointmentDoc(appointmentRequestId) {
      return get(
          /databases/$(database)/documents/appointmentRequests/$(appointmentRequestId)
      );
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/companionSessions/$(sessionId));
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/companionSessions/$(sessionId));
    }

    function canGetUser(userId) {
      return isSelf(userId)
          || isAdmin();
    }

    function canReadAppointmentRequest() {
      return signedIn()
          && (
            isAdmin()
            || resource.data.patientUserId == request.auth.uid
          );
    }

    function canReadCompanionSession() {
      return signedIn()
          && (
            isAdmin()
            || resource.data.patientUserId == request.auth.uid
          );
    }

    function canReadSessionReport() {
      return signedIn()
          && (
            isAdmin()
            || (
              resource.data.sessionId is string
              && sessionExists(resource.data.sessionId)
              && sessionDoc(resource.data.sessionId).data.patientUserId == request.auth.uid
            )
          );
    }

    function canReadAppointmentFollowUp(appointmentRequestId) {
      return signedIn()
          && (
            isAdmin()
            || (
              appointmentExists(appointmentRequestId)
              && appointmentDoc(appointmentRequestId).data.patientUserId == request.auth.uid
            )
          );
    }

    function affectedAny(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function managerDocumentSubmissionContentChanged() {
      return affectedAny([
        'managerDocumentSummary',
        'managerDocumentFiles',
        'managerDocumentFilePaths',
        'managerIdCardStoragePath',
        'managerLicenseStoragePath',
        'managerCriminalRecordStoragePath'
      ]);
    }

    function managerDocumentUpdatedAtIsServerTimestamp() {
      return affectedAny(['managerDocumentUpdatedAt'])
          && request.resource.data.keys().hasAll(['managerDocumentUpdatedAt'])
          && request.resource.data.managerDocumentUpdatedAt is timestamp
          && request.resource.data.managerDocumentUpdatedAt == request.time;
    }

    function managerDocumentSubmissionActionChanged() {
      return managerDocumentSubmissionContentChanged()
          || affectedAny(['managerDocumentStatus']);
    }

    function managerDocumentFileSubmissionChanged() {
      return affectedAny([
        'managerDocumentFiles',
        'managerDocumentFilePaths',
        'managerIdCardStoragePath',
        'managerLicenseStoragePath',
        'managerCriminalRecordStoragePath'
      ]);
    }

    function managerDocumentSummaryWasCleared() {
      return affectedAny(['managerDocumentSummary'])
          && !managerDocumentFileSubmissionChanged()
          && request.resource.data.keys().hasAll(['managerDocumentSummary'])
          && request.resource.data.managerDocumentSummary == '';
    }

    function managerDocumentIsInitialDraft() {
      return managerDocumentFileSubmissionChanged()
          && (
            !resource.data.keys().hasAny(['managerDocumentStatus'])
            || resource.data.managerDocumentStatus == 'NOT_SUBMITTED'
          )
          && (
            !request.resource.data.keys().hasAny(['managerDocumentSummary'])
            || request.resource.data.managerDocumentSummary == ''
          );
    }

    function managerDocumentServerFieldsAreAbsent(data) {
      return !data.keys().hasAny([
        'managerDocumentReviewNote',
        'managerDocumentReviewedAt',
        'managerDocumentReviewedByName',
        'managerDocumentReviewedByAdminUserId',
        'managerDocumentHistory',
        'managerDocumentLegalHoldUntil',
        'managerDocumentLegalHoldReason',
        'managerDocumentLegalHoldByAdminUserId',
        'managerDocumentOriginalsDeletedAt',
        'managerDocumentApprovalEvidence',
        'managerDocumentReviewedSubmissionRevision'
      ]);
    }

    function managerDocumentSubmissionFieldsAreAbsent(data) {
      return !data.keys().hasAny([
        'managerDocumentSummary',
        'managerDocumentFiles',
        'managerDocumentFilePaths',
        'managerIdCardStoragePath',
        'managerLicenseStoragePath',
        'managerCriminalRecordStoragePath',
        'managerDocumentUpdatedAt'
      ]);
    }

    function managerDocumentFilePathIsOwned(data, documentKey) {
      return request.auth.uid.matches('^[A-Za-z0-9_-]{1,128}$')
          && data.keys().hasAll(['managerDocumentFiles', 'managerDocumentFilePaths'])
          && data.managerDocumentFiles is map
          && data.managerDocumentFilePaths is map
          && data.managerDocumentFiles.keys().hasAll([documentKey])
          && data.managerDocumentFilePaths.keys().hasAll([documentKey])
          && data.managerDocumentFiles[documentKey] is map
          && data.managerDocumentFiles[documentKey].keys().hasAll(['fullPath'])
          && data.managerDocumentFiles[documentKey].fullPath is string
          && data.managerDocumentFilePaths[documentKey] is string
          && data.managerDocumentFiles[documentKey].fullPath
              == data.managerDocumentFilePaths[documentKey]
          && data.managerDocumentFiles[documentKey].fullPath.matches(
            '^manager-documents/' + request.auth.uid + '/' + documentKey + '/[^/]+$'
          );
    }

    function managerDocumentLegacyPathMatches(data, documentKey, legacyPathKey) {
      return data.keys().hasAll([legacyPathKey])
          && data[legacyPathKey] is string
          && data[legacyPathKey] == data.managerDocumentFiles[documentKey].fullPath;
    }

    function managerDocumentEntryIsAbsent(data, documentKey, legacyPathKey) {
      return !data.managerDocumentFiles.keys().hasAny([documentKey])
          && !data.managerDocumentFilePaths.keys().hasAny([documentKey])
          && !data.keys().hasAny([legacyPathKey]);
    }

    function managerDocumentHealthEntryIsAbsent(data) {
      return !data.managerDocumentFiles.keys().hasAny(['healthCertificate'])
          && !data.managerDocumentFilePaths.keys().hasAny(['healthCertificate']);
    }

    function managerDocumentFileStateIsConsistent(data) {
      return data.keys().hasAll(['managerDocumentFiles', 'managerDocumentFilePaths'])
          && data.managerDocumentFiles is map
          && data.managerDocumentFilePaths is map
          && data.managerDocumentFiles.keys().hasOnly([
            'idCard', 'license', 'healthCertificate', 'criminalRecord'
          ])
          && data.managerDocumentFilePaths.keys().hasOnly([
            'idCard', 'license', 'healthCertificate', 'criminalRecord'
          ])
          && (
            managerDocumentEntryIsAbsent(
              data,
              'idCard',
              'managerIdCardStoragePath'
            )
            || (
              managerDocumentFileIsReviewable(data, 'idCard')
              && managerDocumentLegacyPathMatches(
                data,
                'idCard',
                'managerIdCardStoragePath'
              )
            )
          )
          && (
            managerDocumentEntryIsAbsent(
              data,
              'license',
              'managerLicenseStoragePath'
            )
            || (
              managerDocumentFileIsReviewable(data, 'license')
              && managerDocumentLegacyPathMatches(
                data,
                'license',
                'managerLicenseStoragePath'
              )
            )
          )
          && (
            managerDocumentHealthEntryIsAbsent(data)
            || managerDocumentFileIsReviewable(data, 'healthCertificate')
          )
          && (
            managerDocumentEntryIsAbsent(
              data,
              'criminalRecord',
              'managerCriminalRecordStoragePath'
            )
            || (
              managerDocumentFileIsReviewable(data, 'criminalRecord')
              && managerDocumentLegacyPathMatches(
                data,
                'criminalRecord',
                'managerCriminalRecordStoragePath'
              )
            )
          );
    }

    function managerDocumentFileIsReviewable(data, documentKey) {
      return managerDocumentFilePathIsOwned(data, documentKey)
          && data.managerDocumentFiles[documentKey].keys().hasAll(['contentType'])
          && data.managerDocumentFiles[documentKey].contentType is string
          && data.managerDocumentFiles[documentKey].contentType
              in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function managerDocumentHasReviewableRequiredFiles(data) {
      return data.keys().hasAll(['managerDocumentFiles'])
          && data.managerDocumentFiles is map
          && data.managerDocumentFiles.keys().hasAll(['idCard', 'criminalRecord'])
          && (
            data.managerDocumentFiles.keys().hasAll(['license'])
            || data.managerDocumentFiles.keys().hasAll(['healthCertificate'])
          );
    }

    function managerDocumentCreateIsSafe() {
      return managerDocumentServerFieldsAreAbsent(request.resource.data)
          && managerDocumentSubmissionFieldsAreAbsent(request.resource.data)
          && (
            (
              request.resource.data.role == 'MANAGER'
              && (
                !request.resource.data.keys().hasAny(['managerDocumentStatus'])
                || request.resource.data.managerDocumentStatus == 'NOT_SUBMITTED'
              )
            )
            || (
              request.resource.data.role != 'MANAGER'
              && !request.resource.data.keys().hasAny(['managerDocumentStatus'])
            )
          );
    }

    function managerDocumentReviewFieldsAreUnchanged() {
      return !affectedAny([
        'managerDocumentReviewNote',
        'managerDocumentReviewedAt',
        'managerDocumentReviewedByName',
        'managerDocumentReviewedByAdminUserId',
        'managerDocumentHistory',
        'managerDocumentLegalHoldUntil',
        'managerDocumentLegalHoldReason',
        'managerDocumentLegalHoldByAdminUserId',
        'managerDocumentOriginalsDeletedAt',
        'managerDocumentApprovalEvidence',
        'managerDocumentReviewedSubmissionRevision'
      ]);
    }

    function managerDocumentSubmissionUpdateIsSafe() {
      return managerDocumentReviewFieldsAreUnchanged()
          && (
            (
              managerDocumentSubmissionActionChanged()
              && managerDocumentUpdatedAtIsServerTimestamp()
              && request.resource.data.keys().hasAll(['managerDocumentStatus'])
              && (
                (
                  request.resource.data.managerDocumentStatus == 'PENDING_REVIEW'
                  && managerDocumentFileStateIsConsistent(request.resource.data)
                  && managerDocumentHasReviewableRequiredFiles(request.resource.data)
                )
                || (
                  request.resource.data.managerDocumentStatus == 'NOT_SUBMITTED'
                  && (
                    managerDocumentSummaryWasCleared()
                    || (
                      managerDocumentIsInitialDraft()
                      && managerDocumentFileStateIsConsistent(request.resource.data)
                    )
                  )
                )
              )
            )
            || (
              !managerDocumentSubmissionActionChanged()
              && !affectedAny(['managerDocumentStatus'])
              && !affectedAny(['managerDocumentUpdatedAt'])
            )
          );
    }

    match /users/{userId} {
      // 사용자 문서는 본인만 직접 읽고, 관리자·교차 프로필 참조는 서버 중계를 사용한다.
      allow get: if canGetUser(userId);
      allow list: if isAdmin();
      allow create: if isSelf(userId)
          && isClientCreatableRole(request.resource.data.role)
          && managerDocumentCreateIsSafe();
      allow update: if isAdmin()
          || (
            isSelf(userId)
            && request.resource.data.role == resource.data.role
            && managerDocumentSubmissionUpdateIsSafe()
          );
      allow delete: if isAdmin();
    }

    match /appointmentRequests/{appointmentRequestId} {
      // 매니저·보호자는 Core API 인가와 마스킹을 거쳐야 하므로 기존 비교 문서를 직접 읽지 않는다.
      allow read: if canReadAppointmentRequest();

      // 예약 원본은 PostgreSQL이며 Firestore는 전환 기간의 읽기 전용 비교 자료로만 유지한다.
      allow create: if false;

      allow update, delete: if false;
    }

    match /companionSessions/{sessionId} {
      // 매니저·보호자는 Core API의 종료 경계와 범위별 동의 판정을 거쳐야 한다.
      allow read: if canReadCompanionSession();

      // 세션과 채팅·위치·읽음 원본은 PostgreSQL이며 기존 문서는 전환 비교용 읽기만 허용한다.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /hospitalGuides/{guideId} {
      // 병원 가이드는 로그인 사용자라면 읽을 수 있고, 수정은 관리자만 가능하다.
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sessionReports/{reportId} {
      // 매니저 원문 회수와 보호자 REPORT 동의는 Core API에서만 판정한다.
      allow read: if canReadSessionReport();

      // 리포트 원본은 PostgreSQL이며 Firestore는 읽기 전용 비교 자료로만 유지한다.
      allow create, update, delete: if false;
    }

    match /appointmentFollowUps/{appointmentRequestId} {
      // 후속 처리 원본은 PostgreSQL이며 Firestore는 읽기 전용 비교 자료로만 유지한다.
      allow read: if canReadAppointmentFollowUp(appointmentRequestId);
      allow create, update, delete: if false;
    }

    match /supportInquiries/{inquiryId} {
      allow read: if isAdmin()
          || (isManager() && resource.data.managerUserId == request.auth.uid);
      allow create: if isManager()
          && request.resource.data.managerUserId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /clientSupportRequests/{supportRequestId} {
      allow read: if isAdmin()
          || (
            signedIn()
            && resource.data.userId == request.auth.uid
          );
      allow create: if (isPatient() || isGuardian())
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userRole == currentRole();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /adminSettlementRecords/{appointmentRequestId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminEmergencyIssues/{appointmentRequestId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminActionNotifications/{notificationId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminAuditLogs/{auditLogId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminActionDeliveries/{deliveryId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminActionDeliveryJobs/{jobId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /appointmentReminderJobs/{jobId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
